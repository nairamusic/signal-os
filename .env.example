# SIGNAL//OS keeps credentials on the server. Never place them in app.js.
PORT=4173
HOST=127.0.0.1

# Required before binding SIGNAL//OS to a non-local network interface.
# Use a long, unique secret supplied by the deployment platform.
SIGNAL_ADMIN_PASSWORD=
SIGNAL_ADMIN_USERNAME=naira-admin

# Suno Platform REST API
SUNO_API_KEY=
SUNO_API_BASE_URL=
SUNO_GENERATE_PATH=/v1/generations

# NairaMusic.com WordPress REST API
WP_BASE_URL=https://nairamusic.com
WP_API_USERNAME=
WP_APPLICATION_PASSWORD=
WP_TRACK_REST_BASE=nmc_track
WP_PUBLISH_STATUS=draft

# Social/video publishing (server-side OAuth tokens only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Distributor / DSP identity (handoff; never store passwords here)
DISTROKID_ACCOUNT_EMAIL=
SPOTIFY_ARTIST_URL=
APPLE_MUSIC_ARTIST_URL=
YOUTUBE_CHANNEL_URL=
AMAZON_MUSIC_ARTIST_URL=
DEEZER_ARTIST_URL=
TIDAL_ARTIST_URL=
SOUNDCLOUD_PROFILE_URL=
